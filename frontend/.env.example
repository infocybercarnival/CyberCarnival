# --- CyberCarnival Frontend Environment Variables ---

# API Backend Base URL (Render deployment)
NEXT_PUBLIC_API_URL=https://cybercarnival.onrender.com

# Cloudflare Turnstile Public Site Key
# Development test sitekey: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEm1nMVahReomCo-

# Base path if hosted under a subdirectory (leave blank for standard domain)
NEXT_PUBLIC_BASE_PATH=

# Support contact email
NEXT_PUBLIC_HELP_EMAIL=info.cybercarnival@gmail.com
