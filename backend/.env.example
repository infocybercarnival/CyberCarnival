# Copy to .env for LOCAL dev. NEVER commit .env.
#
# On Render, don't upload this file — set each of these as a dashboard
# Environment Variable instead: Render dashboard -> your service ->
# Environment -> Add Environment Variable. Same idea on Vercel for the
# frontend's NEXT_PUBLIC_API_URL (see frontend/.env.example).

# --- Flask & Security --------------------------------------------------------
# Secret key for session encryption — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-cybercarnival-2026-local

# "development" locally, "production" on Render.
FLASK_ENV=development

# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=https://cybercarnival-test.vercel.app,https://www.cybercarnival.in

# Public base URL of the site — used to build absolute links for emails and callbacks.
SITE_URL=https://cybercarnival-test.vercel.app

# Optional flag: set to "true" to force SameSite=None and Secure=True on session cookies.
CROSS_SITE_FRONTEND=true


# --- Google OAuth -------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://cybercarnival.onrender.com/api/auth/google/callback
ADMIN_GOOGLE_EMAIL=info.cybercarnival@gmail.com


# --- Cloudflare Turnstile CAPTCHA --------------------------------------------
TURNSTILE_SECRET_KEY=your-turnstile-secret-key


# --- Database (PostgreSQL / Supabase) ----------------------------------------
# Supabase connection string (Project Settings -> Database -> Connection string -> URI)
# Use Transaction Pooler URI for serverless/Render deployment:
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres


# --- Supabase Storage --------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_PAYMENT_PROOFS=payment-proofs
SUPABASE_BUCKET_ASSETS=event-assets


# --- Email / SMTP ------------------------------------------------------------
EMAIL_DEV_MODE=false
EMAIL_SMTP_URL=smtp.gmail.com:587
EMAIL_SMTP_USER=info.cybercarnival@gmail.com
EMAIL_SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=info.cybercarnival@gmail.com
EMAIL_FROM_NAME=CyberCarnival


# --- Manual UPI Payments -----------------------------------------------------
UPI_ID=EZE0266890@CUB
UPI_PAYEE_NAME=CyberCarnival
UPI_DUMMY_MODE=false


# --- Additional Settings ----------------------------------------------------
OTP_EXPIRY_MINUTES=7
PAYMENT_SESSION_MINUTES=10
RATELIMIT_STORAGE_URI=memory://
